{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>Nasus20202/renovate"],
  "timezone": "Europe/Warsaw",
  "labels": ["version-update"],
  "dependencyDashboardTitle": "Version Updates Dashboard",
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "commitMessagePrefix": "chore:",
  "semanticCommits": "enabled",
  "dependencyDashboard": true,
  "automergeType": "pr",
  "automergeStrategy": "rebase",
  "platformAutomerge": true,
  "rebaseWhen": "conflicted",
  "separateMultipleMajor": true,
  "additionalBranchPrefix": "{{packageFile}}/",
  "commitMessageSuffix": "in {{packageFile}}",
  "ignorePaths": ["**/.argocd-state/**"],
  "reviewers": ["Nasus20202"],
  "kubernetes": {
    "managerFilePatterns": ["/.+\\.ya?ml$/"]
  },
  "argocd": {
    "managerFilePatterns": ["/.+\\.ya?ml$/"]
  },
  "helm-values": {
    "managerFilePatterns": ["/.+\\.ya?ml$/"]
  },
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "versioning": "docker"
    }
  ],
  "customManagers": [
    {
      "description": "Update Docker image tags in YAML files",
      "customType": "regex",
      "managerFilePatterns": ["/.+\\.ya?ml$/"],
      "matchStrings": ["(?:image|imageName):\\s*(?<depName>[^\\s:]+):(?<currentValue>[\\w.-]+)"],
      "datasourceTemplate": "docker"
    }
  ]
}
